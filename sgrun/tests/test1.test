$c {
#include <stdio.h>
#include <assert.h>
#include <stdlib.h>
}

$test "A test to check printf" : stdio_suite(printf_test) {
  SGCapture cap;
  saulg.capture_begin(&cap, stdout);

  int res = printf("420");

  char *out = saulg.capture_end(&cap);
  printf("Captured: %s\n", out);
  free(out);
  assert(res == 3);
}

$test "A test to check addition" : math_suite(add_test) {
  assert(1 + 1 == 11);
}
$test "A test to check addition" : math_suite(add_test1) {
  assert(1 + 1 == 2);
}
$test "A test to check addition" : math_suite(add_test2) {
  assert(1 + 2 == 3);
}
$test "A test to check addition" : math_suite(add_test3) {
  assert(1 + 3 == 4);
}
$test "A test to check addition" : math_suite(add_test4) {
  assert(1 + 4 == 5);
}
$test "A test to check addition" : math_suite(add_test5) {
  assert(1 + 5 == 6);
}
