$c {
#include "chucci_lex/lexer.h"
#include "core/srcman.h"
#include "core/string_interner.h"
#include "core/vmem_arena.h"
#include <assert.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

  void test_generate_token_array(Lexer * lexer, size_t len) {
    char buf[32];
    int offset = snprintf(buf, sizeof(buf), "%d", len);

    printf("Token tokens[] = {\n");
    Token token = lexer_next(lexer);
    while (token.kind != TOK_EOF) {
      printf(
          "\t(Token){ .span = { .offset = %*d, .len = %2d, .srcid = %d }, "
          ".kind = %d, .ident = %d },\n",
          offset,
          token.span.offset,
          token.span.len,
          token.span.srcid,
          token.kind,
          token.ident);
      token = lexer_next(lexer);
    }
    printf("};");
    printf("\n");

    fflush(stdout);
    assert(false);
  }
}

$test "Lexer test" : chucci_lex(lexer) {
  VMEMArena* arena = vmarena_new(128 * 1024);
  StringInterner* interner = interner_new(arena);
  SourceManager sman = sman_new();
  bstr str = "  // 1. Preprocessor & Angle Brackets (tests your TOK_ANGLE logic!)\n"
             "#include <stdio.h>\n"
             "#include \" my_local_header.h\""
             "\n"
             "\n"
             "#define MAX_BUFFER 1024\n"
             "\n"
             "/* 2. Multi-line comment testing\n"
             "   Let's put some weird chars here: @ $ % ! \n"
             "   And a pseudo-nested comment to make sure it doesn't break: /* \n"
             "*/\n"
             "typedef struct {\n"
             "    const char* name;\n"
             "    int id;\n"
             "    float val;\n"
             "} TokenData;\n"
             "\n"
             "// 3. Pointers and operators\n"
             "static TokenData* create_token(int new_id) {\n"
             "    TokenData* t = malloc(sizeof(TokenData));\n"
             "    if (t == NULL) return NULL;\n"
             "    t->id = new_id;\n"
             "    t->val = 3.14159;  // float literal\n"
             "    // 4. String literal with escape characters\n"
             "    t->name = \" String with \\\"escaped\\\" quotes and \\\n new lines!\"; "
             "    return t;\n"
             "}\n"
             "\n"
             "int main(int argc, char **argv) {\n"
             "    // 5. Numeric bases and multi-character operators\n"
             "    int hex_val = 0xDEADBEEF;\n"
             "    int shift_val = 1 << 4;\n"
             "    \n"
             "    shift_val <<= 1;\n"
             "    shift_val ^= 0xFF; \n"
             "\n"
             "    if (hex_val == 0xDEADBEEF && shift_val != 0) {\n"
             "        hex_val++;\n"
             "        --shift_val;\n"
             "    }\n"
             "\n"
             "    // 6. Array indexing and ternary operators\n"
             "    int arr[5] = {1, 2, 3, 4, 5, 'h'};\n"
             "    int result = (arr[0] <= arr[4]) ? arr[1] : arr[2];\n"
             "\n"
             "    // 7. Horrible spacing to stress-test your `skip_unwanted` logic\n"
             "    int    spaced_out   =    (  10   * 5)   +   2;\n"
             "\n"
             "    return 0;\n"
             "}\n";
