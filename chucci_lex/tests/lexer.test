      (Token){.span = {.offset = 1137, .len = 1, .srcid = 0}, .kind = TOK_VAL, .ident = 0},
      (Token){.span = {.offset = 1138, .len = 1, .srcid = 0}, .kind = SEP_RSQ, .ident = 0},
      (Token){.span = {.offset = 1140, .len = 1, .srcid = 0}, .kind = OP_COLON, .ident = 0},
      (Token){.span = {.offset = 1142, .len = 3, .srcid = 0}, .kind = TOK_IDENT, .ident = 42},
      (Token){.span = {.offset = 1145, .len = 1, .srcid = 0}, .kind = SEP_LSQ, .ident = 0},
      (Token){.span = {.offset = 1146, .len = 1, .srcid = 0}, .kind = TOK_VAL, .ident = 0},
      (Token){.span = {.offset = 1147, .len = 1, .srcid = 0}, .kind = SEP_RSQ, .ident = 0},
      (Token){.span = {.offset = 1148, .len = 1, .srcid = 0}, .kind = SEP_SEMI, .ident = 0},
      (Token){.span = {.offset = 1224, .len = 3, .srcid = 0}, .kind = KW_INT, .ident = 0},
      (Token){.span = {.offset = 1231, .len = 10, .srcid = 0}, .kind = TOK_IDENT, .ident = 44},
      (Token){.span = {.offset = 1244, .len = 1, .srcid = 0}, .kind = OP_ASSIGN, .ident = 0},
      (Token){.span = {.offset = 1249, .len = 1, .srcid = 0}, .kind = SEP_LPAREN, .ident = 0},
      (Token){.span = {.offset = 1252, .len = 2, .srcid = 0}, .kind = TOK_VAL, .ident = 0},
      (Token){.span = {.offset = 1257, .len = 1, .srcid = 0}, .kind = OP_MUL, .ident = 0},
      (Token){.span = {.offset = 1259, .len = 1, .srcid = 0}, .kind = TOK_VAL, .ident = 0},
      (Token){.span = {.offset = 1260, .len = 1, .srcid = 0}, .kind = SEP_RPAREN, .ident = 0},
      (Token){.span = {.offset = 1264, .len = 1, .srcid = 0}, .kind = OP_ADD, .ident = 0},
      (Token){.span = {.offset = 1268, .len = 1, .srcid = 0}, .kind = TOK_VAL, .ident = 0},
      (Token){.span = {.offset = 1269, .len = 1, .srcid = 0}, .kind = SEP_SEMI, .ident = 0},
      (Token){.span = {.offset = 1276, .len = 6, .srcid = 0}, .kind = KW_RETURN, .ident = 0},
      (Token){.span = {.offset = 1283, .len = 1, .srcid = 0}, .kind = TOK_VAL, .ident = 0},
      (Token){.span = {.offset = 1284, .len = 1, .srcid = 0}, .kind = SEP_SEMI, .ident = 0},
      (Token){.span = {.offset = 1286, .len = 1, .srcid = 0}, .kind = SEP_RCURLY, .ident = 0},
  };
  size_t token_len = sizeof(tokens) / sizeof(Token);
  // test_generate_token_array(&ts, token_len);

  size_t i = 0;
  Token token = ts_next(&ts);
  while (token.kind != TOK_EOF) {
    Token expected = tokens[i];

    printf("%d == %d\n", token.kind, expected.kind);
    assert(token.kind == expected.kind);
    assert(token.span.offset == expected.span.offset);
    assert(token.span.len == expected.span.len);
    assert(token.span.srcid == expected.span.srcid);

    i++;
    token = ts_next(&ts);
  }

  assert(i == token_len);

  ts_free(&ts);
  sman_free(sman);
  interner_free(interner);
  vmarena_free(arena);
}
