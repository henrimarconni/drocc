$c {
#include "core/span.h"
#include "core/string_interner.h"
#include "core/stringdef.h"
#include "core/vmem_arena.h"
#include <assert.h>
#include <stddef.h>
#include <stdio.h>
#include <string.h>
}

$c {
  static bool interner_fuzz(char* buf, size_t len) {
    if (len == 0)
      return false;

    for (size_t i = len; i-- > 0;) {
      if (++buf[i] != 0)
        return true;
      // skip null char
      else
        buf[i] = 1;
    }
    return false;
  }
}

$test "Interner Test" : core(interner) {
  VMEMArena* arena = vmarena_new(128 * 1024);
  StringInterner* interner = interner_new(arena);
  StringView strv = strview("hehe");
  InternID id = intern(strv, interner);
  InternID id2 = intern(strv, interner);
  InternID id3 = intern(strv, interner);
  InternID id4 = intern(strv, interner);
  printf("%d == %d == %d == %d == 1\n", id, id2, id3, id4);
  fflush(stdout);
  assert(id == id2 && id == id3 && id == id4 && id == 1);

  strv = strview("69420");
  id = intern(strv, interner);
  id2 = intern(strv, interner);
  id3 = intern(strv, interner);
  id4 = intern(strv, interner);
  printf("%d == %d == %d == %d == 2\n", id, id2, id3, id4);
  fflush(stdout);
  assert(id == id2 && id == id3 && id == id4 && id == 2);

  interner_free(interner);
  vmarena_free(arena);
}

$test "Interner Resize Test" : core(interner_resize) {
  VMEMArena* arena = vmarena_new(1024 * 1024);
  StringInterner* interner = interner_new(arena);

  char buf[4] = {0};

  StringView strv;
  strv.str = buf;
  uint32_t i = 1;
  uint32_t max_cap = 65535;

  for (uint32_t n = 1; n < sizeof(buf) - 1; n++) {
    if (i >= max_cap)
      break;
    strv.len = n;
    memset(buf, 0, sizeof(buf));
    while (interner_fuzz(buf, n)) {
      InternID id = intern(strv, interner);
      printf("%d == %d for [", id, i);
      for (size_t x = 0; x < strv.len; x++) {
        unsigned char c = (unsigned char)strv.str[x];
        printf("%d", c);
        if (x + 1 != strv.len)
          printf(", ");
      }
      printf("] with len = %d\n", strv.len);
      fflush(stdout);
      assert(i++ == id);
      if (i > max_cap)
        break;
    }
  }

  interner_free(interner);
  vmarena_free(arena);
}
