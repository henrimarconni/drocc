$c {
  #include <stdio.h>
  #include <assert.h>
  #include "core/string_interner.h"
  #include "core/vmem_arena.h"
  #include "core/span.h"
}

$test "Interner Test" : core(interner) {
  VMEMArena* arena = vmarena_new(128 * 1024);
  StringInterner* interner = interner_new(arena);
  Span span;
  span.str = "hehe";
  span.len = 4;
  InternID id = intern(span, interner);
  InternID id2 = intern(span, interner);
  InternID id3 = intern(span, interner);
  InternID id4 = intern(span, interner);
  printf("%d %d %d %d\n", id, id2, id3, id4);
  fflush(stdout);
  assert(id == id2 && id == id3 && id == id4 && id == 0);

  span.str = "69420";
  span.len = 5;
  id = intern(span, interner);
  id2 = intern(span, interner);
  id3 = intern(span, interner);
  id4 = intern(span, interner);
  printf("%d %d %d %d\n", id, id2, id3, id4);
  fflush(stdout);
  assert(id == id2 && id == id3 && id == id4 && id == 1);

  interner_free(interner);
}
